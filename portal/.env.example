# Copie para .env e preencha com os valores do seu Supabase self-hosted
# (ver README.md da raiz do repositorio, secoes 3, 5 e 6).

# --- Supabase (GoTrue / auth), usado via supabase-py para login/refresh ---
# Mesmo valor de SUPABASE_PUBLIC_URL no .env do Supabase.
SUPABASE_URL=http://supabase.lab.internal
# Mesmo valor de SUPABASE_PUBLISHABLE_KEY no .env do Supabase.
SUPABASE_PUBLISHABLE_KEY=changeme
# Endpoint JWKS para validar localmente os tokens (ES256), sem round-trip por request.
SUPABASE_JWKS_URL=http://supabase.lab.internal/auth/v1/.well-known/jwks.json

# --- Banco (asyncpg), acesso direto as tabelas do portal ---
# DSN de uma role Postgres privilegiada (NAO e a mesma coisa que a
# SECRET_KEY/service-role JWT do Supabase, que so vale para chamadas HTTP
# via PostgREST/GoTrue). O asyncpg fala Postgres diretamente e ignora RLS
# por conectar como uma role com privilegio, nao por carregar esse JWT.
#
# Host = "db": o container do portal entra na rede Docker da stack do
# Supabase (ver SUPABASE_DOCKER_NETWORK abaixo) e fala direto com o
# servico/container `db` pelo nome. NAO use a porta 5432 publicada no host
# nem "localhost" - em varias instalacoes self-hosted recentes essa porta
# esta atras do Supavisor (pooler), que exige um identificador de tenant e
# nao aceita uma conexao comum do asyncpg.
PORTAL_DATABASE_URL=postgresql://supabase_admin:changeme@db:5432/postgres

# Nome da rede Docker da stack do Supabase (rode `docker network ls` no
# host para confirmar - geralmente "<nome-da-pasta>_default").
SUPABASE_DOCKER_NETWORK=supabase_default

# IP real da VM (interface de rede, nao 127.0.0.1) onde o dnsmasq do lab
# escuta. O dnsmasq esta configurado com `except-interface=docker0` (README
# raiz, secao 4.2), entao o gateway da bridge do Docker NAO resolve
# *.lab.internal - o container precisa apontar direto para o IP da VM.
PORTAL_DNS_SERVER=192.168.0.15

# --- Sessao do portal (cookie assinado via itsdangerous) ---
# Gere um valor aleatorio forte, ex: python -c "import secrets; print(secrets.token_urlsafe(32))"
PORTAL_SESSION_SECRET=changeme
# Alinhado ao JWT_EXPIRY do Supabase (README secao 6). Ao expirar, o usuario
# e mandado de volta para /login (nao ha refresh automatico nesta versao).
PORTAL_SESSION_MAX_AGE_SECONDS=1800
# true somente se o portal estiver atras de TLS (o lab roda HTTP puro por ora).
PORTAL_COOKIE_SECURE=false

# --- Authorization code flow ---
# Tempo de vida de um `code` emitido por /authorize ate ser trocado em /token.
PORTAL_AUTH_CODE_TTL_SECONDS=60

# --- Bind do servidor ---
PORTAL_HOST=0.0.0.0
PORTAL_PORT=8080
