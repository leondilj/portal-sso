# Copie para .env e preencha (ver README.md deste diretorio e o README da raiz).

# --- Portal SSO ---
# URL completa do endpoint de troca de code do portal.
PORTAL_TOKEN_URL=http://portal.lab.internal/token
# Deve ser IGUAL ao client_secret cadastrado para 'qualidade' em app_clients
# (ver sql/0004_seed_dev_data.sql no repo do portal - troque em qualquer
# ambiente que nao seja o lab local).
QUALIDADE_CLIENT_SECRET=segredo-qualidade-trocar

# --- Supabase (so para validar o JWT via JWKS - sem acesso a banco) ---
SUPABASE_JWKS_URL=http://supabase.lab.internal/auth/v1/.well-known/jwks.json

# --- Sessao propria desta app (cookie assinado via itsdangerous) ---
# Gere um valor aleatorio forte, diferente do PORTAL_SESSION_SECRET do portal
# (sao sessoes independentes).
QUALIDADE_SESSION_SECRET=changeme
QUALIDADE_SESSION_MAX_AGE_SECONDS=1800
QUALIDADE_COOKIE_SECURE=false

# --- Bind do servidor ---
QUALIDADE_HOST=0.0.0.0
QUALIDADE_PORT=8081

# IP real da VM (interface de rede, nao 127.0.0.1) onde o dnsmasq do lab
# escuta. O dnsmasq esta configurado com `except-interface=docker0` (README
# raiz, secao 4.2), entao o gateway da bridge do Docker NAO resolve
# *.lab.internal - o container precisa apontar direto para o IP da VM, para
# conseguir falar com PORTAL_TOKEN_URL e SUPABASE_JWKS_URL acima.
QUALIDADE_DNS_SERVER=192.168.0.15
